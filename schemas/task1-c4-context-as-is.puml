@startuml task1-c4-context-as-is
!include <C4/C4_Context>

title Диаграмма контекста (C4, уровень 1) - система «Тёплый дом», As-Is

Person(homeowner, "Владелец дома", "Житель дома с подключённой системой отопления. Управляет отоплением и следит за температурой через веб-интерфейс.")
Person(installer, "Специалист по установке", "Сотрудник компании «Тёплый дом». Выезжает на объект, монтирует оборудование и регистрирует датчики в системе.")

System(warmhouse, "Система «Тёплый дом»", "Монолитное приложение на Go + PostgreSQL. Позволяет удалённо включать/выключать отопление и просматривать текущую температуру в доме.")

System_Ext(temp_sensor, "Датчик температуры", "Установлен в доме. Отдаёт текущую температуру по синхронному HTTP-запросу от сервера.")
System_Ext(heating_module, "Модуль управления отоплением (реле)", "Установлен в доме. Включает и выключает отопление по команде сервера.")

Rel(homeowner, warmhouse, "Включает/выключает отопление, просматривает температуру", "HTTPS, веб-интерфейс")
Rel(installer, warmhouse, "Регистрирует и настраивает датчики при установке", "HTTPS, REST API")
Rel(warmhouse, temp_sensor, "Запрашивает текущую температуру (синхронный опрос по запросу пользователя)", "HTTP")
Rel(warmhouse, heating_module, "Отправляет команды включения/выключения отопления", "HTTP")

SHOW_LEGEND()
@enduml
